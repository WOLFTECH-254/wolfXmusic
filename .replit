modules = ["nodejs-20", "web", "bash"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
BASE_PATH = "/"

[workflows]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8000
externalPort = 8000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 20193
externalPort = 3000

[deployment]
deploymentTarget = "autoscale"
run = ["sh", "-c", "PORT=5000 node --enable-source-maps ./artifacts/api-server/dist/index.mjs"]
build = ["sh", "-c", "pnpm --filter @workspace/api-server run build && PORT=5000 BASE_PATH=/ pnpm --filter @workspace/wolfxmusic run build"]
